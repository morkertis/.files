# Machine-local zsh config: anything that must NOT be committed.
#
# Copy this file next to it as .private.zsh - that name is gitignored:
#   cp ~/.files/zsh/.private.zsh.example ~/.files/zsh/.private.zsh
#   chmod 600 ~/.files/zsh/.private.zsh
#
# ~/.zshrc sources it last, so it can also override anything set above.

# export ANTHROPIC_API_KEY="..."
# export OPENAI_API_KEY="..."
# export HF_TOKEN="..."

# Work-only paths or settings
# export PATH="$HOME/work/bin:$PATH"
