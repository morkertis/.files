# terminal stuff
alias z="source ~/.zshrc"
alias zz="clear; z"
alias zzz="cd ~; zz"
alias h=history
alias hg="history | grep"

# python
alias ipython=ipython3
alias ipy=ipython

#alias deactivate='pyenv deactivate'
#alias activate='pyenv activate'

# pip stuff
# pip freeze without dependencies 
alias freeze="pip list --not-required --format=freeze | grep -v pip | grep -v setuptools"
alias upip="pip install --upgrade pip"

# nvidia-smi watch
if [ -x "$(command -v nvidia-smi)" ]; then
  alias smi="watch -n 1 nvidia-smi"
fi

# $DOTFILES is exported by .zshrc; the fallback keeps this file usable on its own.
ALIASES_DIR="${DOTFILES:-$HOME/.files}/aliases"

# run private aliases
if [ -f "$ALIASES_DIR/.private.aliases" ]; then
    source "$ALIASES_DIR/.private.aliases"
fi

# run linux specific aliases
if [[ "$OSTYPE" == linux* ]]; then
	if [ -f "$ALIASES_DIR/.linux.aliases" ]; then
		source "$ALIASES_DIR/.linux.aliases"
	fi
fi

